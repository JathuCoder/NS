    if (strcmp(username, "admin") == 0)
    {
        if (strcmp(password, "admin") == 0)
        {
            printf("\n Welcome.Login Success!");
        }
        else
        {
            printf("\n wrong password");
        }
    }
    else
    {
        printf("\n wrong username");
    }
}
